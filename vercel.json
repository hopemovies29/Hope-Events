{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/invitation/:token",
      "destination": "/invitation.html?token=:token"
    },
    {
      "source": "/espace-client/:key",
      "destination": "/espace-client.html?key=:key"
    }
  ]
}
